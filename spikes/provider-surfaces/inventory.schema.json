{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automonique.provider-inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capture_date",
    "immutable_base",
    "licence",
    "raw_manifest",
    "providers",
    "deferred_to",
    "deferred_questions"
  ],
  "properties": {
    "schema": {"const": "automonique.provider-inventory/v1"},
    "capture_date": {"type": "string", "format": "date"},
    "immutable_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "licence": {"const": "Elastic-2.0"},
    "raw_manifest": {"type": "string"},
    "providers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "version",
          "authentication_category",
          "mode_count",
          "capability_fields",
          "surface_file",
          "surface_sha256"
        ],
        "properties": {
          "provider": {"enum": ["claude", "codex", "jcode", "opencode"]},
          "version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "reason"],
            "properties": {
              "value": {"type": ["string", "null"]},
              "reason": {"type": ["string", "null"]}
            }
          },
          "authentication_category": {"type": "string", "minLength": 1},
          "mode_count": {"type": "integer", "minimum": 1},
          "capability_fields": {
            "const": [
              "approval",
              "cancel",
              "create",
              "model",
              "observe",
              "reconnect",
              "resume",
              "steer",
              "usage"
            ]
          },
          "surface_file": {"type": "string"},
          "surface_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "deferred_to": {"const": "R0-07"},
    "deferred_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
