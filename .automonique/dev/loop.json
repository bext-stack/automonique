{
  "schema": "automonique.dev-loop/v1",
  "integration_ceiling": "proposal_only",
  "max_workers": 1,
  "default_driver": "codex_session",
  "drivers": {
    "codex_session": {
      "native_subagents": true,
      "max_concurrent_subagents": 3,
      "recursive_agent_trees": false,
      "concurrent_writes": "disjoint_paths_only",
      "integration_owner": "primary_session"
    },
    "local_process": {
      "max_workers": 1,
      "packet_transport": "final_explicit_argv_element"
    }
  },
  "hill_climbability_threshold": 70,
  "state_path": ".automonique/state/harness-loop.json",
  "worker_sandbox": {
    "binary": "bwrap",
    "network": "none",
    "home": "hidden",
    "git_metadata": "hidden",
    "writable_paths": "objective_allowed_paths_only"
  },
  "safety_checks": [
    [
      "python3",
      "plan/check.py",
      "--verify"
    ],
    [
      "python3",
      "tools/program.py",
      "--verify"
    ],
    [
      "python3",
      "tools/guides.py",
      "--verify"
    ]
  ],
  "forbidden_git_operations": [
    "branch-change",
    "merge",
    "push",
    "force",
    "history-rewrite",
    "remote-edit",
    "tag"
  ]
}
