{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automonique.dev-objectives/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objectives"
  ],
  "properties": {
    "schema": {
      "const": "automonique.dev-objectives/v1"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "work_id",
          "objective",
          "metric",
          "baseline",
          "budget",
          "tests",
          "stop_conditions",
          "hill_climbability",
          "autonomous_eligible",
          "allowed_paths",
          "licence",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "work_id": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "metric": {
            "type": "object",
            "required": [
              "name",
              "target",
              "anti_regression"
            ]
          },
          "baseline": {
            "type": "object",
            "required": [
              "value",
              "reason"
            ]
          },
          "budget": {
            "type": "object",
            "required": [
              "max_iterations",
              "max_wall_seconds",
              "max_worker_seconds",
              "max_unchanged_results",
              "max_failures"
            ]
          },
          "tests": {
            "type": "array",
            "minItems": 1
          },
          "stop_conditions": {
            "type": "array",
            "minItems": 1
          },
          "hill_climbability": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "autonomous_eligible": {
            "type": "boolean"
          },
          "allowed_paths": {
            "type": "array",
            "minItems": 1
          },
          "licence": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
