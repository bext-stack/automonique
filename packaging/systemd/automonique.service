[Unit]
Description=Automonique local automation daemon
Requires=automonique.socket
Requires=automonique-tempfs-owner.service
After=automonique.socket automonique-tempfs-owner.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify-reload
NotifyAccess=main
ExecStart=%S/automonique/bin/automonique daemon --foreground
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStopSec=90s
RuntimeDirectory=automonique
RuntimeDirectoryMode=0700
StateDirectory=automonique
StateDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_STATE_HOME=%S
Environment=AUTOMONIQUE_TEMPFS_OWNER_SOCKET=%t/automonique/tempfs-owner.sock
Delegate=yes

[Install]
WantedBy=default.target
