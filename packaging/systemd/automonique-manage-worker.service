[Unit]
Description=Automonique Manage fleet worker
After=network-online.target automonique.service
PartOf=automonique.service

[Service]
Type=simple
ExecStart=%S/automonique/improvement-code/current/bin/automonique-manage-worker
Restart=on-failure
RestartSec=5s
# Signal only the worker shell first. Its TERM trap stops intake and waits for
# every accepted provider child before exiting; signalling the whole cgroup would
# kill those children before the drain can happen.
KillMode=mixed
TimeoutStopSec=infinity
StateDirectory=automonique
StateDirectoryMode=0700
Environment=AUTOMONIQUE_STATE_DIR=%S/automonique
Environment=AUTOMONIQUE_FLEET_CONCURRENCY=3
Environment=AUTOMONIQUE_PLATFORM_ENDPOINT=http://127.0.0.1:18082
Environment=AUTOMONIQUE_AGENT_AUTH_DIR=%S/automonique/agent-auth
Environment=AUTOMONIQUE_FLEET_CLAUDE_BINARY=%h/.local/bin/claude
# Legacy fallback used only until the native account registry has an explicit
# worker selection. New Codex and Claude accounts use private isolated profiles.
# Environment=AUTOMONIQUE_FLEET_CODEX_HOME=%h/.codex

[Install]
WantedBy=default.target
