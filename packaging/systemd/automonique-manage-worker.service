[Unit]
Description=Automonique Manage fleet worker
After=network-online.target automonique.service
PartOf=automonique.service

[Service]
Type=simple
ExecStart=%S/automonique/improvement-code/current/bin/automonique-manage-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
StateDirectory=automonique
StateDirectoryMode=0700
Environment=AUTOMONIQUE_STATE_DIR=%S/automonique
Environment=AUTOMONIQUE_FLEET_CONCURRENCY=3
# Optional: set this to an owner-managed Codex home with the full operational
# tool host. The daemon's isolated conversation home may deliberately disable it.
# Environment=AUTOMONIQUE_FLEET_CODEX_HOME=%h/.codex

[Install]
WantedBy=default.target
