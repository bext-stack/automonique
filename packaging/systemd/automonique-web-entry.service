[Unit]
Description=Automonique hosted dashboard
After=network.target

[Service]
Type=simple
EnvironmentFile=-%S/automonique/dashboard-runtime.conf
ExecStart=%S/automonique/web-entry/bin/automonique-web-entry --bind 127.0.0.1 --port 18082 --auth-config %S/automonique/dashboard-auth.conf --manage-chat-auth-config %S/automonique/manage-chat-auth.conf --integration-config %S/automonique/dashboard-integration.conf --state-dir ${AUTOMONIQUE_DAEMON_STATE} --runtime-dir %t/automonique --agent-auth-dir %S/automonique/agent-auth --codex-binary %h/.local/bin/codex --claude-binary %h/.local/bin/claude
# A clean process exit is not evidence that the public dashboard was
# intentionally disabled. `systemctl stop` still suppresses restart, while an
# unexpected graceful exit no longer leaves the Cloudflare tunnel serving 502s.
Restart=always
RestartSec=5s
StateDirectory=automonique
StateDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=%t
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
