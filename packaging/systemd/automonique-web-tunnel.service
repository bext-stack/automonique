[Unit]
Description=Cloudflare Tunnel for the Automonique web entry point
After=network-online.target automonique-web-entry.service
Wants=network-online.target
Requires=automonique-web-entry.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --config %h/.cloudflared/config-monique-web.yml --no-autoupdate run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
