[Unit]
Description=Automonique disconnected recovery daemon
Conflicts=automonique.service automonique.socket

[Service]
Type=notify
NotifyAccess=main
ExecStart=%S/automonique/bin/automonique daemon --foreground --disconnected-recovery
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStopSec=90s
RuntimeDirectory=automonique
RuntimeDirectoryMode=0700
StateDirectory=automonique
StateDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_STATE_HOME=%S
Delegate=yes
