{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": [
    "src/**/*.ts",
    "conformance/**/*.ts",
    "generated/**/*.ts"
  ],
  "exclude": [
    "conformance/negative/**/*.ts"
  ]
}
