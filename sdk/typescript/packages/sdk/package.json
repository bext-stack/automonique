{
  "name": "@automonique/sdk",
  "version": "0.1.0",
  "description": "Canonical Automonique Platform client for browsers, React Native, and server-side JavaScript",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bext-stack/automonique.git",
    "directory": "sdk/typescript/packages/sdk"
  },
  "automonique": {
    "protocol": "automonique.platform",
    "protocolRange": "1-2",
    "schema": "automonique.platform/v1",
    "schemas": [
      "automonique.platform/v1",
      "automonique.platform/v2"
    ],
    "schemaDigest": "sha256:1c3f561d137a14321cee480b8035341dd70b526ca501f2d5efd7f817a6e4b845",
    "aggregateSchemaDigest": "sha256:da001afc38661e321ffeec134100fb09a82bd4f49d34948124ffccdfdcd3268d"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/src/index.d.ts",
      "import": "./dist/sdk/src/index.js",
      "default": "./dist/sdk/src/index.js"
    },
    "./testing": {
      "types": "./dist/sdk/src/testing.d.ts",
      "import": "./dist/sdk/src/testing.js",
      "default": "./dist/sdk/src/testing.js"
    },
    "./testing/internal": {
      "types": "./dist/sdk/src/testing/internal.d.ts",
      "import": "./dist/sdk/src/testing/internal.js",
      "default": "./dist/sdk/src/testing/internal.js"
    }
  },
  "scripts": {
    "build": "bunx tsc -p ./tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "bunx tsc -p ./tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "typescript": "6.0.3"
  }
}
